<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone access for SpeechRecognizer (runtime permission, requested in code) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only needed because some devices' recognizers and the browser intents use the network.
         The assistant itself makes no API calls. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Don't hide the app from tablets/devices without a mic in Play; we handle it in code -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: without these, the app cannot see other apps/services -->
    <queries>
        <!-- List launchable apps so "open <app>" works -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Required for SpeechRecognizer.isRecognitionAvailable() -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Required for TextToSpeech engine discovery -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Browser / web search handlers -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAssistant">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>