<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/va_bg"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sunita · सुनीता"
        android:textColor="@color/va_text"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Language toggle + continuous listening -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <RadioGroup
            android:id="@+id/radioLang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/va_accent"
                android:checked="true"
                android:text="English"
                android:textColor="@color/va_text" />

            <RadioButton
                android:id="@+id/rbHindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:buttonTint="@color/va_accent"
                android:text="हिन्दी"
                android:textColor="@color/va_text" />
        </RadioGroup>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchContinuous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep listening "
            android:textColor="@color/va_muted" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tvStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Voice settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPitchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pitch: Normal"
                    android:textColor="@color/va_muted"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekPitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2"
                    android:progress="1"
                    android:progressTint="@color/va_accent"
                    android:thumbTint="@color/va_accent" />

                <TextView
                    android:id="@+id/tvRateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Speed: Normal"
                    android:textColor="@color/va_muted"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2"
                    android:progress="1"
                    android:progressTint="@color/va_accent"
                    android:thumbTint="@color/va_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Voice"
                    android:textColor="@color/va_muted"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:popupBackground="@color/va_card" />
            </LinearLayout>

            <!-- You said -->
            <TextView
                android:id="@+id/tvTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="You said: —"
                android:textColor="@color/va_text"
                android:textSize="17sp" />

            <!-- Assistant -->
            <TextView
                android:id="@+id/tvReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="Assistant: Tap the mic and say “what time is it?”"
                android:textColor="@color/va_accent"
                android:textSize="17sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="Tap the mic to start"
        android:textColor="@color/va_muted"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/micContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/micContainer"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/pulse"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:alpha="0.3"
            android:background="@drawable/bg_pulse"
            android:visibility="invisible" />

        <View
            android:id="@+id/levelRing"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:alpha="0.35"
            android:background="@drawable/bg_pulse"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="Start or stop listening"
            android:elevation="6dp"
            android:src="@drawable/ic_mic" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>