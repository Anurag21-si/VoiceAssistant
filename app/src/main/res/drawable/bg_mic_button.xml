<?xml version="1.0" encoding="utf-8"?>
<!-- Accent colour when idle, red while listening (button.isSelected = true) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="@color/va_listening" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/va_accent" /></shape>
    </item>
</selector>